// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`design tokens > mantém o snapshot dos tokens compilados 1`] = `
":root {
  --ink-black: #0b0814;
  --midnight-violet: #171128;
  --soft-periwinkle: #a994f2;
  --cotton-candy: #fc97b6;
  --periwinkle: #acaad1;
  --lilac-ash: #9f93ae;
  --lavender: #e9e3f0;

  --bg-0: var(--ink-black);
  --bg-1: var(--midnight-violet);
  --bg-2: #1f1836;
  --bg-3: #2a2148;
  --bg-hover: #332a55;
  --border: #2f2750;
  --border-soft: #241d40;
  --text: var(--lavender);
  --text-dim: var(--periwinkle);
  --text-faint: var(--lilac-ash);
  --accent: var(--soft-periwinkle);
  --accent-soft: rgb(169 148 242 / 14%);
  --accent-line: rgb(169 148 242 / 45%);
  --success: var(--soft-periwinkle);
  --warning: var(--cotton-candy);
  --danger: var(--cotton-candy);
  --info: var(--periwinkle);
  --syn-keyword: var(--soft-periwinkle);
  --syn-string: var(--cotton-candy);
  --syn-number: var(--periwinkle);
  --syn-function: var(--lavender);
  --syn-comment: var(--lilac-ash);
  --syn-operator: var(--lilac-ash);
  --syn-nolock: var(--cotton-candy);
}

:root[data-theme='light'] {
  --bg-0: var(--lavender);
  --bg-1: #ffffff;
  --bg-2: #f5f2fa;
  --bg-3: var(--periwinkle);
  --bg-hover: #e0dcf0;
  --border: #d6d1e8;
  --border-soft: #e5e1f2;
  --text: var(--midnight-violet);
  --text-dim: #4a3f6b;
  --text-faint: var(--lilac-ash);
  --accent: var(--soft-periwinkle);
  --accent-soft: rgb(169 148 242 / 14%);
  --accent-line: rgb(169 148 242 / 50%);
  --syn-keyword: #6d4fd6;
  --syn-string: #c9457a;
  --syn-number: #5b4bb8;
  --syn-comment: #8a7fa8;
}

@media (prefers-color-scheme: light) {
  :root:not([data-theme]) {
    --bg-0: var(--lavender);
    --bg-1: #ffffff;
    --bg-2: #f5f2fa;
    --bg-3: var(--periwinkle);
    --bg-hover: #e0dcf0;
    --border: #d6d1e8;
    --border-soft: #e5e1f2;
    --text: var(--midnight-violet);
    --text-dim: #4a3f6b;
    --text-faint: var(--lilac-ash);
    --accent: var(--soft-periwinkle);
    --accent-soft: rgb(169 148 242 / 14%);
    --accent-line: rgb(169 148 242 / 50%);
    --syn-keyword: #6d4fd6;
    --syn-string: #c9457a;
    --syn-number: #5b4bb8;
    --syn-comment: #8a7fa8;
  }
}
"
`;
