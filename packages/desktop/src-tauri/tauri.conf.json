{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sequelei",
  "version": "0.1.0",
  "identifier": "com.sequelei.app",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @sequelei/ui dev",
    "beforeBuildCommand": "corepack pnpm --filter @sequelei/ui build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "title": "Sequelei QueryPilot",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "deb", "appimage"],
    "icon": ["icons/icon.ico"]
  }
}
