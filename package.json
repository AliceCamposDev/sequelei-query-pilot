{
  "name": "sequelei-query-pilot",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "eslint .",
    "lint:styles": "stylelint \"packages/ui/src/**/*.css\"",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{cjs,json,ts,yaml}\" \"docs/design-tokens.md\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{cjs,json,ts,yaml}\" \"docs/design-tokens.md\"",
    "build": "tsc --noEmit",
    "ci": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm lint:styles && corepack pnpm format:check",
    "dev:desktop": "corepack pnpm --filter @sequelei/desktop dev",
    "test": "corepack pnpm --filter @sequelei/core test",
    "test:all": "corepack pnpm --recursive --if-present test",
    "test:coverage": "corepack pnpm --filter @sequelei/core test:coverage",
    "test:rust": "cargo test --manifest-path packages/desktop/src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-plugin-import-x": "^4.6.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.0.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-declaration-strict-value": "^1.10.1"
  }
}
