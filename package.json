{
  "name": "sequelei-query-pilot",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"packages/**/*.ts\" \"*.{json,ts,yaml}\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"*.{json,ts,yaml}\"",
    "build": "tsc --noEmit",
    "test": "corepack pnpm --filter @sequelei/core test",
    "test:all": "corepack pnpm --recursive --if-present test",
    "test:coverage": "corepack pnpm --filter @sequelei/core test:coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "eslint-plugin-import-x": "^4.6.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.0.0"
  }
}
